# ---------------------------------------------------------------------------
# Thinkster sandbox QA automation - local environment template
# Copy to .env for local runs.  In Jenkins these come from Credentials.
# NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Environment (sandbox only - the suite refuses non-sandbox hosts) -------
SANDBOX_BASE_URL=https://sandbox.hellothinkster.com
ELEVATE_STUDENTS_URL=https://elevate-sandbox.hellothinkster.com/students
EXPECTED_PAYMENT_HOST=cde.openpaystaging.com

# --- Secrets (sandbox test values) ----------------------------------------
PARENT_PASSWORD=
SANDBOX_OTP=
SANDBOX_CARD_NUMBER=
SANDBOX_CARD_EXPIRY=
SANDBOX_CARD_CVC=

# QA reCAPTCHA bypass cookie (cookie-string format: cookieName=cookieValue).
# When set, this cookie is applied to the sandbox context before the first
# navigation so the server-side reCAPTCHA check is skipped.
# Obtain the value from the Thinkster QA team.  In Jenkins, bind the credential
# 'thinkster-sandbox-qa-bypass' (Secret text).  Optional — the suite falls back
# to the reCAPTCHA retry path when this variable is absent.
# THINKSTER_QA_BYPASS=

# --- Non-secret test data --------------------------------------------------
PARENT_FIRST_NAME=Test
PARENT_LAST_NAME=Automation
PARENT_COUNTRY=United States
PARENT_COUNTRY_CODE=+1
PARENT_PHONE=(908) 020-4336

STUDENT_FIRST_NAME=Test
STUDENT_GRADE=5

BILLING_POSTAL_CODE=07001
BILLING_COUNTRY=United States

# Timezone used for the appointment picker (also sets the browser timezone).
APPOINTMENT_TIMEZONE=America/New_York


SANDBOX_CORE_API_URL=https://core-api-4.0-sandbox.hellothinkster.com

MAX_SUBMIT_ATTEMPTS=5

HEADLESS=

# --- Execution report email (npm run report:email / report:test) ---------
# In Jenkins SMTP_USER/SMTP_PASSWORD come from the 'qa-report-smtp' credential.
# The sender must be the approved Thinkster mailbox (@hellothinkster.com).
SEND_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Approved Thinkster company mailbox, e.g. qa-reports@hellothinkster.com
SMTP_USER=
# App Password of that mailbox, not the account password.
SMTP_PASSWORD=
# Must also be @hellothinkster.com; defaults to SMTP_USER when empty.
MAIL_FROM=
# Comma-separated.
MAIL_TO=
